# Zkopírujte do .env. Prázdné připojení HA zapne označená demonstrační data.
HOST=127.0.0.1
PORT=4317
HA_URL=
HA_TOKEN=
# Pro živý server zvolte náhodný párovací kód dlouhý alespoň 8 znaků.
TV_CLIENT_TOKEN=
# Pro autorizovaná oznámení zvolte jiný dlouhý náhodný token.
TV_WEBHOOK_TOKEN=
TV_SESSION_STORE=./private/state/sessions.json
TV_SESSION_DAYS=30
NIGHT_CONTROL_ENABLED=0
TV_CONTROL_ENABLED=0
TV_PUBLIC_ORIGIN=http://localhost:4317
CONFIG_PATH=./config.json
# Volitelná vlastní složka fotografií; osobní fotografie neposílejte do Gitu.
# PHOTO_DIR=/path/to/your/album
